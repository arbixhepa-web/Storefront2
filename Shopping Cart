<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GameZone - Shopping Cart</title>

    <!-- Bootstrap: [Team Member Name] -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Project CSS: [Team Member Name] -->
    <link rel="stylesheet" href="style.css">

    <!-- jQuery: [Team Member Name] -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        body {
            background-color: #111827;
            color: white;
        }

        .shopping-container {
            max-width: 1100px;
            margin: 30px auto;
            padding: 25px;
            background-color: #1f2937;
            border-radius: 12px;
        }

        h1, h2 {
            color: white;
        }

        .intro {
            text-align: center;
            color: #d1d5db;
            margin-bottom: 25px;
        }

        .cart-table th {
            background-color: #374151;
            color: white;
        }

        .cart-table td {
            background-color: #1f2937;
            color: white;
            vertical-align: middle;
        }

        .cart-total {
            background-color: #111827;
            padding: 20px;
            margin-top: 20px;
            border-radius: 8px;
            text-align: right;
        }

        .cart-total h3 {
            color: #93c5fd;
        }

        #jsonOutput {
            background-color: #111827;
            color: #93c5fd;
            padding: 20px;
            border: 1px solid #4b5563;
            border-radius: 8px;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            min-height: 100px;
        }

        .status {
            margin-top: 12px;
            font-weight: bold;
        }

        .empty-message {
            text-align: center;
            padding: 20px;
            color: #d1d5db;
        }

        @media (max-width: 600px) {
            .shopping-container {
                margin: 15px;
                padding: 15px;
            }

            .cart-total {
                text-align: left;
            }
        }
    </style>
</head>

<body>

    <!-- Page structure: [Team Member Name] -->
    <header class="text-center p-3">
        <div class="logo">🎮 GameZone</div>
        <p>Your Ultimate Gaming Store</p>
    </header>

    <nav class="text-center p-3">
        <a href="storefront.html" class="btn btn-outline-light m-1">
            Home
        </a>
        <a href="storefront.html#games" class="btn btn-outline-light m-1">
            Games
        </a>
        <a href="storefront.html#accessories" class="btn btn-outline-light m-1">
            Accessories
        </a>
        <a href="storefront.html#about" class="btn btn-outline-light m-1">
            About
        </a>
        <a href="signup.html" class="btn btn-outline-light m-1">
            Sign Up
        </a>
        <a href="product.html" class="btn btn-outline-light m-1">
            Product Management
        </a>
        <a href="shoppingcart.html" class="btn btn-primary m-1"
           aria-current="page">
            Shopping Cart
        </a>
    </nav>

    <main>
        <div class="shopping-container">

            <h1 class="text-center mb-3">Shopping Cart</h1>

            <p class="intro">
                Search for gaming products and add them to your cart.
            </p>

            <!-- Product search: [Team Member Name] -->
            <section class="mb-4">
                <label for="searchInput" class="form-label">
                    Search Products
                </label>

                <div class="input-group">
                    <input
                        type="search"
                        id="searchInput"
                        class="form-control"
                        placeholder="Search by ID, product name, or category">

                    <button
                        type="button"
                        id="searchButton"
                        class="btn btn-primary">
                        Search
                    </button>

                    <button
                        type="button"
                        id="showAllButton"
                        class="btn btn-secondary">
                        Show All
                    </button>
                </div>

                <div id="searchStatus" class="status" role="status"></div>
            </section>

            <!-- Product catalog: [Team Member Name] -->
            <section class="mb-4">
                <h2>Available Products</h2>

                <div class="table-responsive">
                    <table class="table table-bordered cart-table">
                        <thead>
                            <tr>
                                <th>Product ID</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody id="productList"></tbody>
                    </table>
                </div>
            </section>

            <hr>

            <!-- Shopping cart: [Team Member Name] -->
            <section class="mt-4">
                <h2>Your Cart</h2>

                <div class="table-responsive">
                    <table class="table table-bordered cart-table">
                        <thead>
                            <tr>
                                <th>Product ID</th>
                                <th>Product</th>
                                <th>Unit Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody id="cartList"></tbody>
                    </table>
                </div>

                <div class="cart-total">
                    <h3>
                        Cart Total:
                        <span id="cartTotal">$0.00</span>
                    </h3>
                </div>

                <div class="mt-3">
                    <button
                        type="button"
                        id="submitCart"
                        class="btn btn-primary">
                        Submit Cart / Display JSON
                    </button>

                    <button
                        type="button"
                        id="clearCart"
                        class="btn btn-danger">
                        Clear Cart
                    </button>
                </div>

                <div id="cartStatus" class="status" role="status"></div>
            </section>

            <!-- JSON document: [Team Member Name] -->
            <section class="mt-5">
                <h2>Shopping Cart JSON Document</h2>

                <p>
                    Click Submit Cart / Display JSON to generate the JSON
                    document for your shopping cart.
                </p>

                <pre id="jsonOutput">No cart submitted yet.</pre>
            </section>

        </div>
    </main>

    <footer class="text-center p-4">
        <p>&copy; 2026 GameZone. All rights reserved.</p>
    </footer>

    <!-- JavaScript and validation: [Team Member Name] -->
    <!-- Product search and cart functions: [Team Member Name] -->
    <!-- JSON document generation: [Team Member Name] -->
    <script>
        $(document).ready(function () {

            const PRODUCTS_KEY = "gameZoneProducts";
            const CART_KEY = "gameZoneCart";

            // Sample products allow the page to work before connecting
            // product.html or the future Node.js REST API.
            const sampleProducts = [
                {
                    productId: "G001",
                    productDescription: "Adventure Game",
                    productCategory: "Video Games",
                    productUnitOfMeasure: "Each",
                    productPrice: 59.99,
                    productWeight: null
                },
                {
                    productId: "G002",
                    productDescription: "Action Game",
                    productCategory: "Video Games",
                    productUnitOfMeasure: "Each",
                    productPrice: 49.99,
                    productWeight: null
                },
                {
                    productId: "G003",
                    productDescription: "Racing Game",
                    productCategory: "Video Games",
                    productUnitOfMeasure: "Each",
                    productPrice: 39.99,
                    productWeight: null
                },
                {
                    productId: "A001",
                    productDescription: "Gaming Headset",
                    productCategory: "Accessories",
                    productUnitOfMeasure: "Each",
                    productPrice: 79.99,
                    productWeight: null
                },
                {
                    productId: "A002",
                    productDescription: "Wireless Controller",
                    productCategory: "Accessories",
                    productUnitOfMeasure: "Each",
                    productPrice: 64.99,
                    productWeight: null
                },
                {
                    productId: "A003",
                    productDescription: "Gaming Keyboard",
                    productCategory: "Accessories",
                    productUnitOfMeasure: "Each",
                    productPrice: 89.99,
                    productWeight: null
                }
            ];

            // Load products saved by product.html, or use sample products.
            let savedProducts = readJSON(PRODUCTS_KEY, null);
            let products = normalizeProducts(savedProducts);

            if (products.length === 0) {
                products = sampleProducts;
            }

            // Load the cart saved in the browser.
            let cart = readJSON(CART_KEY, []);

            if (!Array.isArray(cart)) {
                cart = [];
            }

            cart = cart.filter(function (item) {
                return item &&
                    typeof item.productId === "string" &&
                    Number.isInteger(Number(item.quantity)) &&
                    Number(item.quantity) > 0 &&
                    Number.isFinite(Number(item.price));
            }).map(function (item) {
                return {
                    productId: item.productId,
                    productName: String(item.productName || "Product"),
                    price: Number(item.price),
                    quantity: Number(item.quantity)
                };
            });

            // Read JSON safely from localStorage.
            function readJSON(key, defaultValue) {
                try {
                    const value = localStorage.getItem(key);

                    if (value === null) {
                        return defaultValue;
                    }

                    return JSON.parse(value);
                } catch (error) {
                    return defaultValue;
                }
            }

            // Support a product object or an array of product objects.
            function normalizeProducts(data) {
                if (!data) {
                    return [];
                }

                let list = [];

                if (Array.isArray(data)) {
                    list = data;
                } else if (typeof data === "object") {
                    list = Object.values(data);
                }

                return list.filter(function (product) {
                    return product &&
                        getProductId(product) !== "" &&
                        getProductName(product) !== "";
                });
            }

            function getProductId(product) {
                return String(
                    product.productId ??
                    product.id ??
                    ""
                ).trim();
            }

            function getProductName(product) {
                return String(
                    product.productDescription ??
                    product.productName ??
                    product.name ??
                    "Unnamed Product"
                ).trim();
            }

            function getPrice(product) {
                const rawPrice = product.productPrice ??
                    product.price ??
                    0;

                // Handles both numeric prices and values such as "$59.99".
                return Number(
                    String(rawPrice).replace(/[$,]/g, "").trim()
                );
            }

            function getCategory(product) {
                return String(
                    product.productCategory ??
                    product.category ??
                    "Other"
                ).trim();
            }

            function formatPrice(price) {
                return Number(price).toLocaleString("en-US", {
                    style: "currency",
                    currency: "USD"
                });
            }

            function saveCart() {
                try {
                    localStorage.setItem(
                        CART_KEY,
                        JSON.stringify(cart)
                    );
                } catch (error) {
                    showCartStatus(
                        "Unable to save the cart in this browser.",
                        false
                    );
                }
            }

            function showCartStatus(message, success) {
                $("#cartStatus")
                    .text(message)
                    .css("color", success ? "#86efac" : "#fca5a5");
            }

            function showSearchStatus(message, success) {
                $("#searchStatus")
                    .text(message)
                    .css("color", success ? "#86efac" : "#fca5a5");
            }

            // Display products in the catalog table.
            function displayProducts(productList) {
                const tbody = $("#productList");
                tbody.empty();

                if (productList.length === 0) {
                    tbody.append(
                        $("<tr>").append(
                            $("<td>", {
                                colspan: 5,
                                class: "empty-message"
                            }).text("No products found.")
                        )
                    );

                    return;
                }

                productList.forEach(function (product) {
                    const id = getProductId(product);
                    const name = getProductName(product);
                    const category = getCategory(product);
                    const price = getPrice(product);

                    const row = $("<tr>");

                    row.append($("<td>").text(id));
                    row.append($("<td>").text(name));
                    row.append($("<td>").text(category));

                    row.append(
                        $("<td>").text(
                            Number.isFinite(price)
                                ? formatPrice(price)
                                : "Price unavailable"
                        )
                    );

                    const addButton = $("<button>", {
                        type: "button",
                        class: "btn btn-success btn-sm add-to-cart",
                        text: "Add to Cart"
                    }).attr("data-product-id", id);

                    row.append(
                        $("<td>").append(addButton)
                    );

                    tbody.append(row);
                });
            }

            // Search by product ID, description, or category.
            function searchProducts() {
                const query = $("#searchInput")
                    .val()
                    .trim()
                    .toLowerCase();

                const results = products.filter(function (product) {
                    return [
                        getProductId(product),
                        getProductName(product),
                        getCategory(product)
                    ].some(function (value) {
                        return value.toLowerCase().includes(query);
                    });
                });

                displayProducts(results);

                showSearchStatus(
                    results.length + " product(s) found.",
                    true
                );
            }

            // Display cart items and calculate the total.
            function displayCart() {
                const tbody = $("#cartList");
                tbody.empty();

                let total = 0;

                if (cart.length === 0) {
                    tbody.append(
                        $("<tr>").append(
                            $("<td>", {
                                colspan: 6,
                                class: "empty-message"
                            }).text("Your shopping cart is empty.")
                        )
                    );
                }

                cart.forEach(function (item) {
                    const subtotal = item.price * item.quantity;
                    total += subtotal;

                    const row = $("<tr>");

                    row.append(
                        $("<td>").text(item.productId)
                    );

                    row.append(
                        $("<td>").text(item.productName)
                    );

                    row.append(
                        $("<td>").text(formatPrice(item.price))
                    );

                    const quantityInput = $("<input>", {
                        type: "number",
                        class: "form-control cart-quantity",
                        min: 1,
                        max: 999,
                        step: 1,
                        value: item.quantity,
                        "aria-label": "Quantity for " + item.productName
                    }).attr("data-product-id", item.productId);

                    row.append(
                        $("<td>").append(quantityInput)
                    );

                    row.append(
                        $("<td>").text(formatPrice(subtotal))
                    );

                    const removeButton = $("<button>", {
                        type: "button",
                        class: "btn btn-danger btn-sm remove-from-cart",
                        text: "Remove"
                    }).attr("data-product-id", item.productId);

                    row.append(
                        $("<td>").append(removeButton)
                    );

                    tbody.append(row);
                });

                $("#cartTotal").text(formatPrice(total));
            }

            // Invalidate previously generated JSON when the cart changes.
            function resetJSONOutput() {
                $("#jsonOutput").text(
                    "Select Submit Cart / Display JSON to generate the document."
                );
            }

            // Add products to the cart.
            $("#productList").on("click", ".add-to-cart", function () {
                const id = String(
                    $(this).attr("data-product-id")
                );

                const product = products.find(function (item) {
                    return getProductId(item) === id;
                });

                if (!product) {
                    showCartStatus(
                        "Product could not be found.",
                        false
                    );
                    return;
                }

                const price = getPrice(product);

                if (!Number.isFinite(price) || price < 0) {
                    showCartStatus(
                        "This product has an invalid price.",
                        false
                    );
                    return;
                }

                const existing = cart.find(function (item) {
                    return item.productId === id;
                });

                if (existing) {
                    if (existing.quantity >= 999) {
                        showCartStatus(
                            "Maximum quantity is 999 per product.",
                            false
                        );
                        return;
                    }

                    existing.quantity += 1;
                } else {
                    cart.push({
                        productId: id,
                        productName: getProductName(product),
                        price: price,
                        quantity: 1
                    });
                }

                saveCart();
                displayCart();
                resetJSONOutput();

                showCartStatus(
                    "Product added to your cart.",
                    true
                );
            });

            // Remove products from the cart.
            $("#cartList").on("click", ".remove-from-cart", function () {
                const id = String(
                    $(this).attr("data-product-id")
                );

                cart = cart.filter(function (item) {
                    return item.productId !== id;
                });

                saveCart();
                displayCart();
                resetJSONOutput();

                showCartStatus(
                    "Product removed from your cart.",
                    true
                );
            });

            // Validate and update the quantity.
            $("#cartList").on("change", ".cart-quantity", function () {
                const id = String(
                    $(this).attr("data-product-id")
                );

                const quantity = Number($(this).val());

                if (!Number.isInteger(quantity) ||
                    quantity < 1 ||
                    quantity > 999) {
                    showCartStatus(
                        "Quantity must be a whole number from 1 to 999.",
                        false
                    );

                    displayCart();
                    return;
                }

                const item = cart.find(function (entry) {
                    return entry.productId === id;
                });

                if (item) {
                    item.quantity = quantity;

                    saveCart();
                    displayCart();
                    resetJSONOutput();

                    showCartStatus("Quantity updated.", true);
                }
            });

            // Search button.
            $("#searchButton").on("click", searchProducts);

            // Search when Enter is pressed.
            $("#searchInput").on("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    searchProducts();
                }
            });

            // Show the complete catalog.
            $("#showAllButton").on("click", function () {
                $("#searchInput").val("");
                displayProducts(products);

                showSearchStatus(
                    "Showing all available products.",
                    true
                );
            });

            // Generate the JSON shopping cart document.
            $("#submitCart").on("click", function () {
                if (cart.length === 0) {
                    showCartStatus(
                        "Add at least one product before submitting.",
                        false
                    );

                    $("#jsonOutput").text(
                        "No JSON document generated. Your cart is empty."
                    );

                    return;
                }

                const shoppingCart = {
                    shoppingCart: cart.map(function (item) {
                        return {
                            productId: item.productId,
                            productName: item.productName,
                            price: Number(item.price.toFixed(2)),
                            quantity: item.quantity,
                            subtotal: Number(
                                (item.price * item.quantity).toFixed(2)
                            )
                        };
                    }),

                    total: Number(
                        cart.reduce(function (sum, item) {
                            return sum +
                                item.price * item.quantity;
                        }, 0).toFixed(2)
                    )
                };

                $("#jsonOutput").text(
                    JSON.stringify(shoppingCart, null, 2)
                );

                showCartStatus(
                    "Shopping cart JSON document generated successfully.",
                    true
                );

                /*
                 * AJAX REST API placeholder:
                 * The Node.js REST API will be developed later.
                 * No server request is made by this page yet.
                 */
            });

            // Empty the shopping cart.
            $("#clearCart").on("click", function () {
                cart = [];

                saveCart();
                displayCart();

                $("#jsonOutput").text("No cart submitted yet.");

                showCartStatus(
                    "Your shopping cart has been cleared.",
                    true
                );
            });

            // Display the products and saved cart when the page opens.
            displayProducts(products);
            displayCart();

        });
    </script>

</body>
</html>
