
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GameZone - Shopping Cart</title>

    <!-- Bootstrap: [Team Member Name] -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- CSS: [Team Member Name] -->
    <link rel="stylesheet" href="style.css">

    <!-- jQuery: [Team Member Name] -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        /* CSS: [Team Member Name] */
        .shopping-cart-container {
            max-width: 1100px;
            margin: 30px auto;
            padding: 30px;
            background-color: #1f2937;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
        }

        .shopping-cart-container h1,
        .shopping-cart-container h2 {
            color: white;
        }

        .cart-intro {
            color: #d1d5db;
            text-align: center;
            margin-bottom: 30px;
        }

        .cart-search {
            margin-bottom: 20px;
        }

        .cart-search .form-control,
        .cart-search .form-select,
        .cart-quantity {
            background-color: #f9fafb;
            color: #111827;
        }

        .cart-table {
            color: white;
            vertical-align: middle;
        }

        .cart-table th {
            background-color: #374151;
            color: white;
        }

        .cart-table td {
            background-color: #1f2937;
            color: white;
        }

        .cart-table .form-control {
            min-width: 75px;
        }

        .cart-total {
            background-color: #111827;
            padding: 20px;
            border-radius: 8px;
            text-align: right;
            margin-top: 20px;
        }

        .cart-total h3 {
            color: #93c5fd;
        }

        .cart-json {
            margin-top: 30px;
        }

        .cart-json pre {
            background-color: #111827;
            color: #93c5fd;
            border: 1px solid #4b5563;
            border-radius: 8px;
            padding: 20px;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            min-height: 100px;
        }

        .cart-status {
            margin-top: 15px;
            font-weight: bold;
        }

        .empty-cart {
            color: #d1d5db;
            text-align: center;
            padding: 25px;
        }

        @media (max-width: 600px) {
            .shopping-cart-container {
                padding: 15px;
                margin: 15px auto;
            }

            .cart-total {
                text-align: left;
            }
        }
    </style>
</head>

<body>

    <!-- HTML page structure: [Team Member Name] -->
    <header>
        <div class="logo">🎮 GameZone</div>
        <p>Your Ultimate Gaming Store</p>
    </header>

    <nav>
        <a href="storefront.html">Home</a>
        <a href="storefront.html#games">Games</a>
        <a href="storefront.html#accessories">Accessories</a>
        <a href="storefront.html#about">About</a>
        <a href="signup.html">Sign Up</a>
        <a href="product.html">Product Management</a>
        <a href="shoppingcart.html" aria-current="page">Shopping Cart</a>
    </nav>

    <main>
        <section class="shopping-cart-container">

            <h1 class="text-center">Shopping Cart</h1>

            <p class="cart-intro">
                Search for your favorite gaming products and add them to your cart.
            </p>

            <!-- jQuery product search: [Team Member Name] -->
            <section class="cart-search">
                <label for="searchInput" class="form-label">
                    Search Products
                </label>

                <div class="input-group">
                    <input
                        type="search"
                        class="form-control"
                        id="searchInput"
                        placeholder="Search by product name, ID, or category"
                        aria-label="Search products">

                    <button
                        type="button"
                        class="btn btn-primary"
                        id="searchButton">
                        Search
                    </button>

                    <button
                        type="button"
                        class="btn btn-outline-light"
                        id="showAllButton">
                        Show All
                    </button>
                </div>
            </section>

            <!-- Product catalog: [Team Member Name] -->
            <section>
                <h2>Available Products</h2>

                <div class="table-responsive">
                    <table class="table cart-table table-bordered">
                        <thead>
                            <tr>
                                <th>Product ID</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody id="productList">
                            <tr>
                                <td colspan="5" class="empty-cart">
                                    Loading products...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div id="searchStatus" class="cart-status" role="status"
                     aria-live="polite"></div>
            </section>

            <hr class="my-4">

            <!-- Shopping cart HTML: [Team Member Name] -->
            <section>
                <h2>Your Cart</h2>

                <div class="table-responsive">
                    <table class="table cart-table table-bordered">
                        <thead>
                            <tr>
                                <th>Product ID</th>
                                <th>Product</th>
                                <th>Unit Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody id="cartList">
                            <tr>
                                <td colspan="6" class="empty-cart">
                                    Your shopping cart is empty.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="cart-total">
                    <h3>
                        Cart Total:
                        <span id="cartTotal">$0.00</span>
                    </h3>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <button
                        type="button"
                        class="btn btn-primary"
                        id="submitCart">
                        Submit Cart / Display JSON
                    </button>

                    <button
                        type="button"
                        class="btn btn-outline-light"
                        id="clearCart">
                        Clear Cart
                    </button>
                </div>

                <div id="cartStatus" class="cart-status" role="status"
                     aria-live="polite"></div>
            </section>

            <!-- JSON shopping cart document: [Team Member Name] -->
            <section class="cart-json">
                <h2>Shopping Cart JSON Document</h2>

                <p class="text-light">
                    The JSON document appears here after you select
                    Submit Cart / Display JSON.
                </p>

                <pre id="jsonOutput">No cart submitted yet.</pre>
            </section>

        </section>
    </main>

    <footer class="text-center p-4">
        <p>&copy; 2026 GameZone. All rights reserved.</p>
    </footer>

    <!-- JavaScript validation and cart behavior: [Team Member Name] -->
    <!-- jQuery product search: [Team Member Name] -->
    <!-- JSON document generation: [Team Member Name] -->
    <script>
        $(function () {

            const PRODUCTS_KEY = "gameZoneProducts";
            const CART_KEY = "gameZoneCart";

            /*
             * Temporary sample products are provided for testing.
             * Products saved by product.html can replace this catalog.
             * No backend or REST API is required for this demonstration.
             */
            const sampleProducts = [
                {
                    productId: "G001",
                    productDescription: "Adventure Game",
                    productCategory: "Video Games",
                    productUnitOfMeasure: "Each",
                    productPrice: 59.99,
                    productWeight: null
                },
                {
                    productId: "G002",
                    productDescription: "Action Game",
                    productCategory: "Video Games",
                    productUnitOfMeasure: "Each",
                    productPrice: 49.99,
                    productWeight: null
                },
                {
                    productId: "G003",
                    productDescription: "Racing Game",
                    productCategory: "Video Games",
                    productUnitOfMeasure: "Each",
                    productPrice: 39.99,
                    productWeight: null
                },
                {
                    productId: "A001",
                    productDescription: "Gaming Controller",
                    productCategory: "Controllers",
                    productUnitOfMeasure: "Each",
                    productPrice: 39.99,
                    productWeight: null
                },
                {
                    productId: "A002",
                    productDescription: "Gaming Headset",
                    productCategory: "Accessories",
                    productUnitOfMeasure: "Each",
                    productPrice: 59.99,
                    productWeight: null
                },
                {
                    productId: "A003",
                    productDescription: "Gaming Keyboard",
                    productCategory: "Accessories",
                    productUnitOfMeasure: "Each",
                    productPrice: 69.99,
                    productWeight: null
                }
            ];

            let products = loadProducts();
            let cart = loadCart();

            // Read products created by product.html when available.
            function loadProducts() {
                try {
                    const saved = localStorage.getItem(PRODUCTS_KEY);

                    if (saved !== null) {
                        const parsed = JSON.parse(saved);

                        if (Array.isArray(parsed)) {
                            return parsed;
                        }

                        if (parsed && typeof parsed === "object") {
                            return Object.values(parsed);
                        }
                    }
                } catch (error) {
                    console.error("Could not read saved products.", error);
                }

                return sampleProducts.slice();
            }

            // Restore the shopping cart from this browser.
            function loadCart() {
                try {
                    const saved = localStorage.getItem(CART_KEY);
                    const parsed = saved ? JSON.parse(saved) : [];

                    if (Array.isArray(parsed)) {
                        return parsed.filter(function (item) {
                            return item &&
                                typeof item.productId === "string" &&
                                Number.isInteger(item.quantity) &&
                                item.quantity > 0;
                        });
                    }
                } catch (error) {
                    console.error("Could not read the saved cart.", error);
                }

                return [];
            }

            function saveCart() {
                try {
                    localStorage.setItem(CART_KEY, JSON.stringify(cart));
                } catch (error) {
                    showCartStatus(
                        "The cart could not be saved in browser storage.",
                        false
                    );
                }
            }

            // Support the price format used in product.html.
            function getPrice(product) {
                const rawPrice = product.productPrice;

                if (typeof rawPrice === "number") {
                    return rawPrice;
                }

                if (typeof rawPrice === "string") {
                    return Number(rawPrice.replace(/[$,]/g, ""));
                }

                return NaN;
            }

            function getProductId(product) {
                return String(product.productId ?? "").trim();
            }

            function getProductName(product) {
                return String(
                    product.productDescription ??
                    product.productName ??
                    "Unnamed Product"
                );
            }

            function formatPrice(price) {
                return price.toLocaleString("en-US", {
                    style: "currency",
                    currency: "USD"
                });
            }

            function showSearchStatus(message, success) {
                $("#searchStatus")
                    .text(message)
                    .css("color", success ? "#86efac" : "#fca5a5");
            }

            function showCartStatus(message, success) {
                $("#cartStatus")
                    .text(message)
                    .css("color", success ? "#86efac" : "#fca5a5");
            }

            // Build product rows safely using text(), not HTML product data.
            function displayProducts(list) {
                const tbody = $("#productList");
                tbody.empty();

                if (list.length === 0) {
                    tbody.append(
                        $("<tr>").append(
                            $("<td>", {
                                colspan: 5,
                                class: "empty-cart"
                            }).text("No matching products found.")
                        )
                    );
                    return;
                }

                list.forEach(function (product) {
                    const id = getProductId(product);
                    const name = getProductName(product);
                    const category = String(
                        product.productCategory ?? "Other"
                    );
                    const price = getPrice(product);

                    if (!id || !Number.isFinite(price) || price < 0) {
                        return;
                    }

                    const row = $("<tr>");

                    row.append($("<td>").text(id));
                    row.append($("<td>").text(name));
                    row.append($("<td>").text(category));
                    row.append(
                        $("<td>").text(formatPrice(price))
                    );

                    const addButton = $("<button>", {
                        type: "button",
                        class: "btn btn-success btn-sm add-to-cart",
                        text: "Add to Cart"
                    }).attr("data-product-id", id);

                    row.append($("<td>").append(addButton));
                    tbody.append(row);
                });

                if (tbody.children().length === 0) {
                    tbody.append(
                        $("<tr>").append(
                            $("<td>", {
                                colspan: 5,
                                class: "empty-cart"
                            }).text("No valid products available.")
                        )
                    );
                }
            }

            // Search by ID, description, or category.
            function searchProducts() {
                const query = $("#searchInput").val()
                    .trim()
                    .toLowerCase();

                const results = products.filter(function (product) {
                    return [
                        getProductId(product),
                        getProductName(product),
                        String(product.productCategory ?? "")
                    ].some(function (value) {
                        return value.toLowerCase().includes(query);
                    });
                });

                displayProducts(results);

                showSearchStatus(
                    results.length + " product(s) found.",
                    true
                );
            }

            // Draw the cart and recalculate all subtotals.
            function displayCart() {
                const tbody = $("#cartList");
                tbody.empty();

                let total = 0;

                if (cart.length === 0) {
                    tbody.append(
                        $("<tr>").append(
                            $("<td>", {
                                colspan: 6,
                                class: "empty-cart"
                            }).text("Your shopping cart is empty.")
                        )
                    );
                }

                cart.forEach(function (item) {
                    const price = Number(item.price);
                    const subtotal = price * item.quantity;
                    total += subtotal;

                    const row = $("<tr>");

                    row.append(
                        $("<td>").text(item.productId)
                    );

                    row.append(
                        $("<td>").text(item.productName)
                    );

                    row.append(
                        $("<td>").text(formatPrice(price))
                    );

                    const quantityInput = $("<input>", {
                        type: "number",
                        class: "form-control cart-quantity",
                        min: 1,
                        max: 999,
                        step: 1,
                        value: item.quantity,
                        "aria-label": "Quantity for " + item.productName
                    }).attr("data-product-id", item.productId);

                    row.append(
                        $("<td>").append(quantityInput)
                    );

                    row.append(
                        $("<td>").text(formatPrice(subtotal))
                    );

                    const removeButton = $("<button>", {
                        type: "button",
                        class: "btn btn-danger btn-sm remove-from-cart",
                        text: "Remove"
                    }).attr("data-product-id", item.productId);

                    row.append(
                        $("<td>").append(removeButton)
                    );

                    tbody.append(row);
                });

                $("#cartTotal").text(formatPrice(total));
            }

            // Add product to cart or increase its quantity.
            $("#productList").on("click", ".add-to-cart", function () {
                const id = String($(this).attr("data-product-id"));

                const product = products.find(function (item) {
                    return getProductId(item) === id;
                });

                if (!product) {
                    showCartStatus("Product could not be found.", false);
                    return;
                }

                const price = getPrice(product);

                if (!Number.isFinite(price) || price < 0) {
                    showCartStatus("This product has an invalid price.", false);
                    return;
                }

                const existing = cart.find(function (item) {
                    return item.productId === id;
                });

                if (existing) {
                    if (existing.quantity >= 999) {
                        showCartStatus(
                            "Maximum quantity is 999 per product.",
                            false
                        );
                        return;
                    }

                    existing.quantity += 1;
                } else {
                    cart.push({
                        productId: id,
                        productName: getProductName(product),
                        price: price,
                        quantity: 1
                    });
                }

                saveCart();
                displayCart();
                $("#jsonOutput").text(
                    "Select Submit Cart / Display JSON to generate the document."
                );

                showCartStatus("Product added to your cart.", true);
            });

            // Remove a product completely from the cart.
            $("#cartList").on("click", ".remove-from-cart", function () {
                const id = String($(this).attr("data-product-id"));

                cart = cart.filter(function (item) {
                    return item.productId !== id;
                });

                saveCart();
                displayCart();

                $("#jsonOutput").text(
                    "Select Submit Cart / Display JSON to generate the document."
                );

                showCartStatus("Product removed from your cart.", true);
            });

            // Validate and update quantity.
            $("#cartList").on("change", ".cart-quantity", function () {
                const id = String($(this).attr("data-product-id"));
                const quantity = Number($(this).val());

                if (!Number.isInteger(quantity) ||
                    quantity < 1 ||
                    quantity > 999) {
                    showCartStatus(
                        "Quantity must be a whole number from 1 to 999.",
                        false
                    );

                    displayCart();
                    return;
                }

                const item = cart.find(function (entry) {
                    return entry.productId === id;
                });

                if (item) {
                    item.quantity = quantity;
                    saveCart();
                    displayCart();

                    $("#jsonOutput").text(
                        "Select Submit Cart / Display JSON to generate the document."
                    );

                    showCartStatus("Quantity updated.", true);
                }
            });

            // Search buttons.
            $("#searchButton").on("click", searchProducts);

            $("#searchInput").on("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    searchProducts();
                }
            });

            $("#showAllButton").on("click", function () {
                $("#searchInput").val("");
                displayProducts(products);
                showSearchStatus("Showing all available products.", true);
            });

            // Generate the required JSON shopping cart document.
            $("#submitCart").on("click", function () {
                if (cart.length === 0) {
                    showCartStatus(
                        "Add at least one product before submitting the cart.",
                        false
                    );

                    $("#jsonOutput").text(
                        "No JSON document generated. Your cart is empty."
                    );
                    return;
                }

                const shoppingCart = {
                    shoppingCart: cart.map(function (item) {
                        return {
                            productId: item.productId,
                            productName: item.productName,
                            price: Number(item.price.toFixed(2)),
                            quantity: item.quantity,
                            subtotal: Number(
                                (item.price * item.quantity).toFixed(2)
                            )
                        };
                    }),
                    total: Number(
                        cart.reduce(function (sum, item) {
                            return sum + item.price * item.quantity;
                        }, 0).toFixed(2)
                    )
                };

                $("#jsonOutput").text(
                    JSON.stringify(shoppingCart, null, 2)
                );

                showCartStatus(
                    "Shopping cart JSON document generated successfully.",
                    true
                );

                /*
                 * AJAX REST API placeholder:
                 * The Node.js REST API will be developed in a later assignment.
                 * When the API is available, send the shoppingCart object using
                 * $.ajax() with JSON.stringify(shoppingCart).
                 * No server request is made in this assignment.
                 */
            });

            // Clear all cart items.
            $("#clearCart").on("click", function () {
                cart = [];
                saveCart();
                displayCart();

                $("#jsonOutput").text("No cart submitted yet.");
                showCartStatus("Your shopping cart has been cleared.", true);
            });

            // Initial page setup.
            displayProducts(products);
            displayCart();

        });
    </script>

</body>
</html>
