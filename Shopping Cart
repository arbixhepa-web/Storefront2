<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GameZone - Shopping Cart</title>

    <!-- Bootstrap CSS: Team Member 1 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Project stylesheet -->
    <link rel="stylesheet" href="style.css">

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Shopping cart page styles: Team Member 1 -->
    <style>
        body {
            background: #0b1120;
            color: #f9fafb;
            font-family: Arial, sans-serif;
            margin: 0;
        }

        header {
            background: #111827;
            padding: 25px 15px;
            text-align: center;
            border-bottom: 2px solid #2563eb;
        }

        header h1 {
            color: #60a5fa;
            font-size: 2.2rem;
            font-weight: bold;
            margin-bottom: 5px;
        }

        header p {
            color: #d1d5db;
            margin: 0;
        }

        nav {
            background: #1f2937;
            padding: 15px;
            text-align: center;
        }

        nav a {
            margin: 4px;
        }

        .page-container {
            max-width: 1150px;
            margin: 30px auto;
            padding: 25px;
            background: #111827;
            border: 1px solid #374151;
            border-radius: 12px;
        }

        .section-title {
            color: #60a5fa;
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 18px;
        }

        .intro {
            color: #d1d5db;
            text-align: center;
            margin-bottom: 25px;
        }

        .form-control,
        .form-select {
            background: #f9fafb;
            color: #111827;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #60a5fa;
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.25);
        }

        .btn {
            border-radius: 6px;
            font-weight: bold;
            transition: 0.2s;
        }

        .btn-primary {
            background: #2563eb;
            border-color: #2563eb;
        }

        .btn-primary:hover {
            background: #1d4ed8;
        }

        .btn-success {
            background: #059669;
            border-color: #059669;
        }

        .btn-success:hover {
            background: #047857;
        }

        .btn-danger {
            background: #dc2626;
            border-color: #dc2626;
        }

        .btn-danger:hover {
            background: #b91c1c;
        }

        .table-responsive {
            border-radius: 8px;
            overflow: hidden;
        }

        .cart-table {
            margin-bottom: 0;
            vertical-align: middle;
        }

        .cart-table thead th {
            background: #1f2937;
            color: #93c5fd;
            padding: 14px;
            white-space: nowrap;
        }

        .cart-table tbody td {
            background: #172033;
            color: #f9fafb;
            padding: 12px;
        }

        .cart-table tbody tr:hover td {
            background: #202c42;
        }

        .cart-table .form-control {
            min-width: 75px;
            max-width: 100px;
        }

        .empty-message {
            text-align: center;
            padding: 25px !important;
            color: #d1d5db !important;
        }

        .status-message {
            margin-top: 12px;
            min-height: 22px;
            font-weight: bold;
        }

        .cart-summary {
            background: #1f2937;
            padding: 20px;
            margin-top: 20px;
            border-radius: 8px;
            text-align: right;
            border: 1px solid #374151;
        }

        .cart-summary h3 {
            color: #60a5fa;
            margin: 0;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        #jsonOutput {
            background: #080d18;
            color: #93c5fd;
            border: 1px solid #374151;
            border-radius: 8px;
            padding: 18px;
            min-height: 100px;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .page-divider {
            border-color: #374151;
            margin: 30px 0;
        }

        footer {
            background: #111827;
            color: #9ca3af;
            text-align: center;
            padding: 20px;
            margin-top: 30px;
        }

        @media (max-width: 600px) {
            .page-container {
                margin: 15px;
                padding: 15px;
            }

            header h1 {
                font-size: 1.8rem;
            }

            .cart-summary {
                text-align: left;
            }

            .action-buttons .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <!-- Header section: Team Member 1 -->
    <header>
        <h1>🎮 GameZone</h1>
        <p>Your Ultimate Gaming Store</p>
    </header>

    <!-- Navigation section: Team Member 1 -->
    <nav>
        <a href="storefront.html" class="btn btn-outline-light">Home</a>
        <a href="storefront.html#games" class="btn btn-outline-light">Games</a>
        <a href="storefront.html#accessories" class="btn btn-outline-light">
            Accessories
        </a>
        <a href="storefront.html#about" class="btn btn-outline-light">About</a>
        <a href="signup.html" class="btn btn-outline-light">Sign Up</a>
        <a href="product.html" class="btn btn-outline-light">
            Product Management
        </a>
        <a href="shoppingcart.html" class="btn btn-primary">
            Shopping Cart
        </a>
    </nav>

    <main class="page-container">

        <h2 class="text-center mb-3">Shopping Cart</h2>

        <p class="intro">
            Search for your favorite gaming products and add them to your cart.
        </p>

        <!-- Product search section: Team Member 1 -->
        <section class="mb-4">
            <h3 class="section-title">Search Products</h3>

            <div class="input-group">
                <input
                    type="search"
                    id="searchInput"
                    class="form-control"
                    placeholder="Search by product ID, name, or category"
                    aria-label="Search products">

                <button
                    type="button"
                    id="searchButton"
                    class="btn btn-primary">
                    Search
                </button>

                <button
                    type="button"
                    id="showAllButton"
                    class="btn btn-secondary">
                    Show All
                </button>
            </div>

            <div
                id="searchStatus"
                class="status-message"
                role="status">
            </div>
        </section>

        <!-- Product catalog section: Team Member 1 -->
        <section>
            <h3 class="section-title">Available Products</h3>

            <div class="table-responsive">
                <table class="table table-bordered cart-table">
                    <thead>
                        <tr>
                            <th>Product ID</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody id="productList"></tbody>
                </table>
            </div>
        </section>

        <hr class="page-divider">

        <!-- Shopping cart section: Team Member 1 -->
        <section>
            <h3 class="section-title">Your Shopping Cart</h3>

            <div class="table-responsive">
                <table class="table table-bordered cart-table">
                    <thead>
                        <tr>
                            <th>Product ID</th>
                            <th>Product Name</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody id="cartList"></tbody>
                </table>
            </div>

            <div class="cart-summary">
                <h3>
                    Cart Total:
                    <span id="cartTotal">$0.00</span>
                </h3>
            </div>

            <div class="action-buttons">
                <button
                    type="button"
                    id="submitCart"
                    class="btn btn-primary">
                    Submit Cart / Display JSON
                </button>

                <button
                    type="button"
                    id="clearCart"
                    class="btn btn-danger">
                    Clear Cart
                </button>
            </div>

            <div
                id="cartStatus"
                class="status-message"
                role="status">
            </div>
        </section>

        <!-- JSON output section: Team Member 1 -->
        <hr class="page-divider">

        <section>
            <h3 class="section-title">Shopping Cart JSON Document</h3>

            <p>
                Submit your cart to display the shopping cart information
                in JSON format.
            </p>

            <pre id="jsonOutput">No cart submitted yet.</pre>
        </section>

    </main>

    <footer>
        <p>&copy; 2026 GameZone. All rights reserved.</p>
    </footer>

    <!--
        Team Member 1:
        Product search, cart management, quantity updates,
        total calculation, and JSON document generation.
    -->

    <script>
        $(document).ready(function () {

            const PRODUCTS_KEY = "gameZoneProducts";
            const CART_KEY = "gameZoneCart";

            // Sample products for testing the shopping cart.
            // The page uses products saved by product.html when available.
            const sampleProducts = [
                {
                    productId: "G001",
                    productDescription: "Adventure Game",
                    productCategory: "Video Games",
                    productUnitOfMeasure: "Each",
                    productPrice: 59.99,
                    productWeight: null
                },
                {
                    productId: "G002",
                    productDescription: "Action Game",
                    productCategory: "Video Games",
                    productUnitOfMeasure: "Each",
                    productPrice: 49.99,
                    productWeight: null
                },
                {
                    productId: "G003",
                    productDescription: "Racing Game",
                    productCategory: "Video Games",
                    productUnitOfMeasure: "Each",
                    productPrice: 39.99,
                    productWeight: null
                },
                {
                    productId: "A001",
                    productDescription: "Gaming Headset",
                    productCategory: "Accessories",
                    productUnitOfMeasure: "Each",
                    productPrice: 79.99,
                    productWeight: null
                },
                {
                    productId: "A002",
                    productDescription: "Wireless Controller",
                    productCategory: "Accessories",
                    productUnitOfMeasure: "Each",
                    productPrice: 64.99,
                    productWeight: null
                },
                {
                    productId: "A003",
                    productDescription: "Gaming Keyboard",
                    productCategory: "Accessories",
                    productUnitOfMeasure: "Each",
                    productPrice: 89.99,
                    productWeight: null
                }
            ];

            // Read saved information from localStorage.
            function readJSON(key, defaultValue) {
                try {
                    const savedValue = localStorage.getItem(key);

                    if (savedValue === null) {
                        return defaultValue;
                    }

                    return JSON.parse(savedValue);
                } catch (error) {
                    return defaultValue;
                }
            }

            // Get product information from different possible field names.
            function getProductId(product) {
                return String(
                    product.productId ?? product.id ?? ""
                ).trim();
            }

            function getProductName(product) {
                return String(
                    product.productDescription ??
                    product.productName ??
                    product.name ??
                    "Unnamed Product"
                ).trim();
            }

            function getProductCategory(product) {
                return String(
                    product.productCategory ??
                    product.category ??
                    "Other"
                ).trim();
            }

            function getProductPrice(product) {
                const value = product.productPrice ?? product.price ?? 0;

                return Number(
                    String(value).replace(/[$,]/g, "").trim()
                );
            }

            // Convert the saved product data into an array.
            function normalizeProducts(data) {
                let productArray = [];

                if (Array.isArray(data)) {
                    productArray = data;
                } else if (data && typeof data === "object") {
                    productArray = Object.values(data);
                }

                return productArray.filter(function (product) {
                    return product &&
                        getProductId(product) !== "" &&
                        getProductName(product) !== "";
                });
            }

            // Load saved products or use the sample catalog.
            const savedProducts = readJSON(PRODUCTS_KEY, null);

            let products = normalizeProducts(savedProducts);

            if (products.length === 0) {
                products = sampleProducts;
            }

            // Load saved shopping cart information.
            let cart = readJSON(CART_KEY, []);

            if (!Array.isArray(cart)) {
                cart = [];
            }

            // Validate and clean saved cart items.
            cart = cart.filter(function (item) {
                return item &&
                    typeof item.productId === "string" &&
                    Number.isInteger(Number(item.quantity)) &&
                    Number(item.quantity) >= 1 &&
                    Number(item.quantity) <= 999 &&
                    Number.isFinite(Number(item.price)) &&
                    Number(item.price) >= 0;
            }).map(function (item) {
                return {
                    productId: item.productId,
                    productName: String(item.productName || "Product"),
                    price: Number(item.price),
                    quantity: Number(item.quantity)
                };
            });

            // Format prices as US dollars.
            function formatPrice(price) {
                return Number(price).toLocaleString("en-US", {
                    style: "currency",
                    currency: "USD"
                });
            }

            // Save the shopping cart.
            function saveCart() {
                try {
                    localStorage.setItem(
                        CART_KEY,
                        JSON.stringify(cart)
                    );
                } catch (error) {
                    showCartStatus(
                        "Could not save the cart in this browser.",
                        false
                    );
                }
            }

            // Display feedback messages.
            function showCartStatus(message, success) {
                $("#cartStatus")
                    .text(message)
                    .css("color", success ? "#86efac" : "#fca5a5");
            }

            function showSearchStatus(message, success) {
                $("#searchStatus")
                    .text(message)
                    .css("color", success ? "#86efac" : "#fca5a5");
            }

            // Clear old JSON when the cart changes.
            function resetJSONOutput() {
                $("#jsonOutput").text(
                    "Your cart changed. Submit the cart to generate updated JSON."
                );
            }

            // Display products in the available products table.
            function displayProducts(productArray) {
                const tbody = $("#productList");

                tbody.empty();

                if (productArray.length === 0) {
                    const row = $("<tr>");

                    row.append(
                        $("<td>", {
                            colspan: 5,
                            class: "empty-message"
                        }).text("No products found.")
                    );

                    tbody.append(row);
                    return;
                }

                productArray.forEach(function (product) {
                    const id = getProductId(product);
                    const name = getProductName(product);
                    const category = getProductCategory(product);
                    const price = getProductPrice(product);

                    const row = $("<tr>");

                    row.append($("<td>").text(id));
                    row.append($("<td>").text(name));
                    row.append($("<td>").text(category));

                    row.append(
                        $("<td>").text(
                            Number.isFinite(price) && price >= 0
                                ? formatPrice(price)
                                : "Invalid price"
                        )
                    );

                    const addButton = $("<button>", {
                        type: "button",
                        class: "btn btn-success btn-sm",
                        text: "Add to Cart"
                    }).attr("data-product-id", id);

                    row.append(
                        $("<td>").append(addButton)
                    );

                    tbody.append(row);
                });
            }

            // Search by product ID, product name, or category.
            function searchProducts() {
                const searchText = $("#searchInput")
                    .val()
                    .trim()
                    .toLowerCase();

                const results = products.filter(function (product) {
                    return [
                        getProductId(product),
                        getProductName(product),
                        getProductCategory(product)
                    ].some(function (value) {
                        return value.toLowerCase().includes(searchText);
                    });
                });

                displayProducts(results);

                showSearchStatus(
                    results.length + " product(s) found.",
                    true
                );
            }

            // Display cart items and calculate the total.
            function displayCart() {
                const tbody = $("#cartList");

                tbody.empty();

                let total = 0;

                if (cart.length === 0) {
                    const row = $("<tr>");

                    row.append(
                        $("<td>", {
                            colspan: 6,
                            class: "empty-message"
                        }).text("Your shopping cart is empty.")
                    );

                    tbody.append(row);
                }

                cart.forEach(function (item) {
                    const subtotal = item.price * item.quantity;

                    total += subtotal;

                    const row = $("<tr>");

                    row.append(
                        $("<td>").text(item.productId)
                    );

                    row.append(
                        $("<td>").text(item.productName)
                    );

                    row.append(
                        $("<td>").text(formatPrice(item.price))
                    );

                    const quantityInput = $("<input>", {
                        type: "number",
                        class: "form-control cart-quantity",
                        min: 1,
                        max: 999,
                        step: 1,
                        value: item.quantity,
                        "aria-label": "Quantity for " + item.productName
                    }).attr("data-product-id", item.productId);

                    row.append(
                        $("<td>").append(quantityInput)
                    );

                    row.append(
                        $("<td>").text(formatPrice(subtotal))
                    );

                    const removeButton = $("<button>", {
                        type: "button",
                        class: "btn btn-danger btn-sm",
                        text: "Remove"
                    }).attr("data-product-id", item.productId);

                    row.append(
                        $("<td>").append(removeButton)
                    );

                    tbody.append(row);
                });

                $("#cartTotal").text(formatPrice(total));
            }

            // Add a product to the shopping cart.
            $("#productList").on("click", ".btn-success", function () {
                const id = String(
                    $(this).attr("data-product-id")
                );

                const product = products.find(function (item) {
                    return getProductId(item) === id;
                });

                if (!product) {
                    showCartStatus("Product not found.", false);
                    return;
                }

                const price = getProductPrice(product);

                if (!Number.isFinite(price) || price < 0) {
                    showCartStatus("This product has an invalid price.", false);
                    return;
                }

                const existingItem = cart.find(function (item) {
                    return item.productId === id;
                });

                if (existingItem) {
                    if (existingItem.quantity >= 999) {
                        showCartStatus(
                            "Maximum quantity is 999.",
                            false
                        );
                        return;
                    }

                    existingItem.quantity += 1;
                } else {
                    cart.push({
                        productId: id,
                        productName: getProductName(product),
                        price: price,
                        quantity: 1
                    });
                }

                saveCart();
                displayCart();
                resetJSONOutput();

                showCartStatus("Product added to your cart.", true);
            });

            // Remove a product from the cart.
            $("#cartList").on("click", ".btn-danger", function () {
                const id = String(
                    $(this).attr("data-product-id")
                );

                cart = cart.filter(function (item) {
                    return item.productId !== id;
                });

                saveCart();
                displayCart();
                resetJSONOutput();

                showCartStatus("Product removed from your cart.", true);
            });

            // Update the quantity of an item in the cart.
            $("#cartList").on("change", ".cart-quantity", function () {
                const id = String(
                    $(this).attr("data-product-id")
                );

                const quantity = Number($(this).val());

                if (!Number.isInteger(quantity) ||
                    quantity < 1 ||
                    quantity > 999) {

                    showCartStatus(
                        "Enter a whole number from 1 to 999.",
                        false
                    );

                    displayCart();
                    return;
                }

                const item = cart.find(function (cartItem) {
                    return cartItem.productId === id;
                });

                if (item) {
                    item.quantity = quantity;

                    saveCart();
                    displayCart();
                    resetJSONOutput();

                    showCartStatus("Quantity updated.", true);
                }
            });

            // Search button.
            $("#searchButton").on("click", function () {
                searchProducts();
            });

            // Search when the user presses Enter.
            $("#searchInput").on("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    searchProducts();
                }
            });

            // Display all products.
            $("#showAllButton").on("click", function () {
                $("#searchInput").val("");

                displayProducts(products);

                showSearchStatus(
                    "Showing all available products.",
                    true
                );
            });

            // Generate and display the shopping cart JSON.
            $("#submitCart").on("click", function () {
                if (cart.length === 0) {
                    showCartStatus(
                        "Add a product before submitting your cart.",
                        false
                    );

                    $("#jsonOutput").text(
                        "No JSON document generated because the cart is empty."
                    );

                    return;
                }

                const shoppingCart = {
                    shoppingCart: cart.map(function (item) {
                        return {
                            productId: item.productId,
                            productName: item.productName,
                            price: Number(item.price.toFixed(2)),
                            quantity: item.quantity,
                            subtotal: Number(
                                (item.price * item.quantity).toFixed(2)
                            )
                        };
                    }),

                    total: Number(
                        cart.reduce(function (sum, item) {
                            return sum + item.price * item.quantity;
                        }, 0).toFixed(2)
                    )
                };

                $("#jsonOutput").text(
                    JSON.stringify(shoppingCart, null, 2)
                );

                showCartStatus(
                    "Shopping cart JSON generated successfully.",
                    true
                );

                /*
                    AJAX REST API placeholder.

                    The Node.js REST API will be added later.
                    This page currently generates JSON locally.
                */
            });

            // Clear all items from the cart.
            $("#clearCart").on("click", function () {
                cart = [];

                saveCart();
                displayCart();

                $("#jsonOutput").text("No cart submitted yet.");

                showCartStatus(
                    "Your shopping cart has been cleared.",
                    true
                );
            });

            // Load the products and cart when the page opens.
            displayProducts(products);
            displayCart();

        });
    </script>

</body>
</html>
